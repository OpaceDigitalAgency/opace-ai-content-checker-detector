  "$id": "https://schemas.opace.agency/content-integrity/v1/envelope.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
