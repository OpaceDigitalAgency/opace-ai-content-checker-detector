{
  "name": "@opacedev/ai-content-checker-cli",
  "version": "0.0.0-private",
  "private": true,
  "description": "Free AI content checker CLI: offline text checks, receipts and printable reports, plus AI detection through an explicitly configured local Python model.",
  "keywords": [
    "ai-checker",
    "ai-detector",
    "ai-content-checker",
    "cli",
    "offline",
    "developer-tools",
    "ai-content-detector",
    "ai-text-checker",
    "command-line"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "opace-ai-checker": "./dist/main.js",
    "opace-integrity": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/sync-shared-report.mjs --check && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@opacedev/ai-content-checker-contracts": "file:../contracts",
    "@opacedev/ai-content-checker-core": "file:../core",
    "@opacedev/ai-content-checker-client": "file:../client",
    "canonicalize": "4.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
