{
  "name": "@opace/content-integrity-core",
  "version": "0.0.0-private",
  "private": true,
  "description": "Deterministic offline content-integrity checks, reviewed diffs and hash-only receipts.",
  "keywords": ["content-integrity", "offline", "receipts", "text-analysis"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/bundle.js"}},
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/bundle.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test ../../tests/core/unit/*.test.mjs ../../tests/core/imports/*.test.mjs ../../tests/core/performance/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {"@opace/content-integrity-contracts":"file:../contracts","canonicalize": "4.0.0"},
  "devDependencies": {"esbuild":"0.28.2","typescript": "5.9.2"}
}
