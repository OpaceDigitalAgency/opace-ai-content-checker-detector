{
  "name": "@opacedev/ai-content-checker-core",
  "version": "0.0.0-private",
  "private": true,
  "description": "Free offline text-checking engine for AI content checker applications: invisible Unicode, lookalike letters, protected facts, editing signals and receipts. Model-free.",
  "keywords": [
    "ai-checker",
    "ai-detector",
    "ai-content-checker",
    "invisible-characters",
    "receipts",
    "offline",
    "content-integrity",
    "ai-content-detector",
    "typescript",
    "content-review"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/bundle.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test ../../tests/core/unit/*.test.mjs ../../tests/core/imports/*.test.mjs ../../tests/core/performance/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@opacedev/ai-content-checker-contracts": "file:../contracts",
    "canonicalize": "4.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
