{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opace.agency/content-integrity/v1/checker-result.schema.json",
  "title": "Opace AI Content Integrity checker result",
  "description": "A surface-neutral result and export contract. It keeps AI-pattern, text-integrity/provenance and editorial readings independent and carries the route and resource controls that produced the result.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "result_id",
    "profile",
    "generated_at",
    "contains_content",
    "source",
    "route",
    "axes",
    "sections",
    "methods",
    "provenance",
    "exports",
    "abuse_controls",
    "limitations"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "contract_version": {"$ref": "common.schema.json#/$defs/contractVersion"},
    "result_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "profile": {"enum": ["full_checker", "primitive"]},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "contains_content": {"type": "boolean"},
    "source": {"$ref": "#/$defs/sourceSummary"},
    "route": {"$ref": "#/$defs/route"},
    "axes": {"$ref": "#/$defs/axes"},
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "methods": {
      "type": "array",
      "items": {"$ref": "method-result.schema.json"}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "exports": {"$ref": "#/$defs/exports"},
    "abuse_controls": {"$ref": "#/$defs/abuseControls"},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"contains_content": {"const": false}},
        "required": ["contains_content"]
      },
      "then": {
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "not": {
                "type": "object",
                "properties": {"passage": {"type": "string"}},
                "required": ["passage"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "axes": {
            "type": "object",
            "properties": {
              "ai_pattern": {
                "type": "object",
                "properties": {"assessment_status": {"const": "assessed"}},
                "required": ["assessment_status"]
              }
            },
            "required": ["ai_pattern"]
          }
        },
        "required": ["axes"]
      },
      "then": {
        "properties": {
          "sections": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sourceSummary": {
      "type": "object",
      "required": ["content_hash", "normalised_hash", "content_type", "language", "word_count", "character_count", "section_count"],
      "properties": {
        "content_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "normalised_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "content_type": {"enum": ["plain_text", "html", "markdown"]},
        "language": {"type": "string"},
        "word_count": {"type": "integer", "minimum": 0},
        "character_count": {"type": "integer", "minimum": 0},
        "section_count": {"type": "integer", "minimum": 0}
      }
    },
    "cycle5Model": {
      "type": "object",
      "required": ["identity", "registry_identity", "precision", "segmentation_contract", "input_contract", "features_contract", "scoring_contract", "flag_rule"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "registry_identity": {"type": ["string", "null"]},
        "precision": {"enum": ["fp32", "int8", "other"]},
        "artefact_hash": {"oneOf": [{"$ref": "common.schema.json#/$defs/hash"}, {"type": "null"}]},
        "segmentation_contract": {"type": "string", "minLength": 1},
        "input_contract": {"type": "string", "minLength": 1},
        "features_contract": {"type": "string", "minLength": 1},
        "scoring_contract": {"type": "string", "minLength": 1},
        "flag_rule": {
          "type": "object",
          "required": ["expression", "primary_margin", "secondary_gap"],
          "properties": {
            "expression": {"type": "string", "minLength": 1},
            "primary_margin": {"type": "number"},
            "secondary_gap": {"type": "number"}
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["kind", "location", "content_transfer", "privacy_route", "retention", "consent", "model"],
      "properties": {
        "kind": {"enum": ["browser_model", "eu_server", "wordpress_same_site", "loopback_engine", "deterministic_only"]},
        "location": {"type": "string", "minLength": 1},
        "content_transfer": {"enum": ["none", "same_site", "loopback", "eu_server"]},
        "privacy_route": {"$ref": "common.schema.json#/$defs/privacyRoute"},
        "retention": {
          "type": "object",
          "required": ["source", "result"],
          "properties": {
            "source": {"enum": ["none", "request_only", "session", "job"]},
            "result": {"enum": ["none", "session", "receipt", "job"]},
            "statement": {"type": "string", "minLength": 1}
          }
        },
        "consent": {"enum": ["not_required", "explicit"]},
        "model": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cycle5Model"}
          ]
        },
        "transport": {
          "type": "object",
          "properties": {
            "endpoint_class": {"type": "string"},
            "region": {"type": ["string", "null"]},
            "requests": {"type": "integer", "minimum": 0},
            "words_sent": {"type": "integer", "minimum": 0},
            "processed": {"type": "string"},
            "retained": {"type": "string"}
          }
        }
      }
    },
    "aiPatternAxis": {
      "type": "object",
      "required": ["assessment_status", "method_status", "source", "raw_score", "raw_margin", "display_score", "score_scale", "level", "primary_display_threshold", "secondary_display_threshold", "flagged", "flag_reason", "strongest_section_index", "reason", "limitations"],
      "properties": {
        "assessment_status": {"enum": ["assessed", "not_assessed", "withheld", "error"]},
        "method_status": {"$ref": "common.schema.json#/$defs/status"},
        "source": {"type": ["string", "null"]},
        "raw_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "raw_margin": {"type": ["number", "null"]},
        "display_score": {"type": ["string", "null"], "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
        "score_scale": {"const": "zero_to_one_pattern_similarity"},
        "level": {
          "oneOf": [
            {"$ref": "#/$defs/aiLevel"},
            {"type": "null"}
          ]
        },
        "primary_display_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "secondary_display_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "flagged": {"type": ["boolean", "null"]},
        "flag_reason": {"enum": ["primary", "secondary", null]},
        "strongest_section_index": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"assessment_status": {"const": "assessed"}}, "required": ["assessment_status"]},
          "then": {
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "raw_score": {"type": "number"},
              "raw_margin": {"type": "number"},
              "display_score": {"type": "string"},
              "level": {"$ref": "#/$defs/aiLevel"},
              "primary_display_threshold": {"type": ["number", "null"]},
              "secondary_display_threshold": {"type": ["number", "null"]},
              "flagged": {"type": "boolean"},
              "strongest_section_index": {"type": "integer"}
            }
          }
        },
        {
          "if": {"properties": {"assessment_status": {"enum": ["not_assessed", "withheld", "error"]}}, "required": ["assessment_status"]},
          "then": {
            "properties": {
              "raw_score": {"type": "null"},
              "raw_margin": {"type": "null"},
              "display_score": {"type": "null"},
              "level": {"type": "null"},
              "primary_display_threshold": {"type": "null"},
              "secondary_display_threshold": {"type": "null"},
              "flagged": {"type": "null"},
              "flag_reason": {"type": "null"},
              "strongest_section_index": {"type": "null"}
            }
          }
        }
      ]
    },
    "aiLevel": {
      "enum": ["signal-strongly-ai", "signal-likely-ai", "signal-potentially-ai", "signal-unclear", "signal-likely-human"]
    },
    "axes": {
      "type": "object",
      "required": ["ai_pattern", "text_integrity", "editorial"],
      "properties": {
        "ai_pattern": {"$ref": "#/$defs/aiPatternAxis"},
        "text_integrity": {
          "type": "object",
          "required": ["method_status", "reading", "reason", "findings", "limitations"],
          "properties": {
            "method_status": {"$ref": "common.schema.json#/$defs/status"},
            "reading": {"enum": ["clean", "attention", "manipulated", "inconclusive", "error"]},
            "reason": {"type": "string", "minLength": 1},
            "findings": {"type": "array", "items": {"type": "object"}},
            "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
          }
        },
        "editorial": {
          "type": "object",
          "required": ["method_status", "reading", "reason", "findings", "limitations"],
          "properties": {
            "method_status": {"$ref": "common.schema.json#/$defs/status"},
            "reading": {"enum": ["none", "some", "many", "not_assessed", "error"]},
            "reason": {"type": "string", "minLength": 1},
            "findings": {"type": "array", "items": {"type": "object"}},
            "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["trained_model", "measured_pattern", "editorial_rule", "character", "provenance", "watermark", "limitation"]},
        "summary": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "basis": {"type": "string"}
      }
    },
    "section": {
      "type": "object",
      "required": ["index", "start_utf16", "end_utf16", "word_count", "raw_score", "raw_margin", "display_score", "level", "band_id", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "description": "Zero-based engine index. Presentation layers add one for reader-facing section numbers."},
        "start_utf16": {"type": "integer", "minimum": 0},
        "end_utf16": {"type": "integer", "minimum": 1},
        "word_count": {"type": "integer", "minimum": 0},
        "raw_score": {"type": "number", "minimum": 0, "maximum": 1},
        "raw_margin": {"type": "number", "description": "Raw Cycle-5 AI-logit minus human-logit margin used by margin-v1. It is not a displayed probability."},
        "display_score": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
        "level": {"$ref": "#/$defs/aiLevel"},
        "band_id": {"enum": ["very_likely_ai", "uncertain", "likely_human", "very_likely_human"]},
        "passage": {"type": "string"},
        "locator": {
          "type": "object",
          "required": ["content_hash", "start_utf16", "end_utf16"],
          "properties": {
            "content_hash": {"$ref": "common.schema.json#/$defs/hash"},
            "start_utf16": {"type": "integer", "minimum": 0},
            "end_utf16": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "anyOf": [
        {"type": "object", "properties": {"passage": {"type": "string"}}, "required": ["passage"]},
        {"type": "object", "properties": {"locator": {"type": "object"}}, "required": ["locator"]}
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["protected_facts", "c2pa_text", "c2pa_files", "watermarks", "safe_fixes"],
      "properties": {
        "protected_facts": {
          "type": "object",
          "required": ["count", "categories"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "c2pa_text": {
          "type": "object",
          "required": ["status", "wrapper_protected", "limitations"],
          "properties": {
            "status": {"enum": ["present", "absent", "invalid", "untrusted", "not_run", "unsupported", "error"]},
            "wrapper_protected": {"type": "boolean"},
            "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        },
        "c2pa_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file_hash", "media_type", "status", "trust", "limitations"],
            "properties": {
              "file_hash": {"$ref": "common.schema.json#/$defs/hash"},
              "media_type": {"type": "string", "minLength": 1},
              "status": {"enum": ["present", "absent", "invalid", "untrusted", "not_run", "unsupported", "error"]},
              "trust": {"enum": ["trusted", "untrusted", "not_validated", "not_applicable"]},
              "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method_id", "method_status", "key_scope", "outcome", "limitations"],
            "properties": {
              "method_id": {"type": "string", "minLength": 1},
              "method_status": {"$ref": "common.schema.json#/$defs/status"},
              "key_scope": {"enum": ["public_test", "provider_private", "none"]},
              "outcome": {"enum": ["detected", "not_detected", "not_available", "not_supported", "not_run", "error"]},
              "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        },
        "safe_fixes": {
          "type": "object",
          "required": ["preview_first", "explicit_approval_required", "automatic_homoglyph_replacement", "c2pa_wrapper_protected"],
          "properties": {
            "preview_first": {"const": true},
            "explicit_approval_required": {"const": true},
            "automatic_homoglyph_replacement": {"const": false},
            "c2pa_wrapper_protected": {"const": true}
          }
        }
      }
    },
    "sharePayload": {
      "type": "object",
      "required": ["version", "result_id", "level", "display_score", "sections", "word_count", "date", "model_version", "honesty_line", "contains_content"],
      "properties": {
        "version": {"const": 1},
        "result_id": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "level": {"$ref": "#/$defs/aiLevel"},
        "display_score": {"type": "string"},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "raw_score", "display_score", "level"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "raw_score": {"type": "number", "minimum": 0, "maximum": 1},
              "display_score": {"type": "string"},
              "level": {"$ref": "#/$defs/aiLevel"}
            }
          }
        },
        "word_count": {"type": "integer", "minimum": 0},
        "date": {"type": "string", "format": "date"},
        "model_version": {"type": "string", "minLength": 1},
        "honesty_line": {"type": "string", "minLength": 1},
        "contains_content": {"const": false}
      }
    },
    "exports": {
      "type": "object",
      "required": ["receipt", "share", "report"],
      "properties": {
        "receipt": {
          "type": "object",
          "required": ["available", "contains_content", "canonicalisation"],
          "properties": {
            "available": {"type": "boolean"},
            "contains_content": {"const": false},
            "canonicalisation": {"enum": ["RFC8785", "none"]},
            "payload_hash": {"oneOf": [{"$ref": "common.schema.json#/$defs/hash"}, {"type": "null"}]}
          }
        },
        "share": {
          "type": "object",
          "required": ["available", "contains_content", "payload"],
          "properties": {
            "available": {"type": "boolean"},
            "contains_content": {"const": false},
            "payload": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/sharePayload"}
              ]
            }
          }
        },
        "report": {
          "type": "object",
          "required": ["available", "format", "contains_content", "explicit_user_action", "complete_evidence", "product_identity", "support_destination"],
          "properties": {
            "available": {"type": "boolean"},
            "format": {"enum": ["pdf", "html", "json", "jsonl", "none"]},
            "contains_content": {"type": "boolean"},
            "explicit_user_action": {"type": "boolean"},
            "complete_evidence": {"type": "boolean"},
            "product_identity": {"type": "string", "minLength": 1},
            "support_destination": {"type": "string", "format": "uri"}
          }
        }
      }
    },
    "controlState": {"enum": ["enforced", "not_applicable", "not_configured"]},
    "abuseControls": {
      "type": "object",
      "required": ["max_words", "max_characters", "max_request_bytes", "explicit_capture", "consent_before_transfer", "refuse_not_truncate", "cancellation", "channel_authentication", "proof_of_work", "origin_validation", "per_ip_limit", "per_site_limit", "per_connection_limit", "global_inference_limit", "request_body_logging", "unexpected_network_requests", "fallback", "kill_switch"],
      "properties": {
        "max_words": {"type": ["integer", "null"], "minimum": 1},
        "max_characters": {"type": ["integer", "null"], "minimum": 1},
        "max_request_bytes": {"type": ["integer", "null"], "minimum": 1},
        "explicit_capture": {"$ref": "#/$defs/controlState"},
        "consent_before_transfer": {"$ref": "#/$defs/controlState"},
        "refuse_not_truncate": {"$ref": "#/$defs/controlState"},
        "cancellation": {"$ref": "#/$defs/controlState"},
        "channel_authentication": {"enum": ["browser_pow_token", "chrome_extension_challenge_token", "wordpress_challenge_token", "same_site_nonce", "loopback_bearer", "not_applicable", "not_configured"]},
        "proof_of_work": {"$ref": "#/$defs/controlState"},
        "origin_validation": {"$ref": "#/$defs/controlState"},
        "per_ip_limit": {"$ref": "#/$defs/controlState"},
        "per_site_limit": {"$ref": "#/$defs/controlState"},
        "per_connection_limit": {"$ref": "#/$defs/controlState"},
        "global_inference_limit": {"$ref": "#/$defs/controlState"},
        "request_body_logging": {"enum": ["excluded", "not_applicable", "not_configured"]},
        "unexpected_network_requests": {"enum": ["blocked", "not_applicable", "not_configured"]},
        "fallback": {"$ref": "#/$defs/controlState"},
        "kill_switch": {"$ref": "#/$defs/controlState"}
      }
    }
  }
}
