{
  "name": "@opacedev/ai-content-checker-client",
  "version": "0.0.0-private",
  "private": true,
  "description": "Typed local API client for AI content checker integrations: authenticated loopback requests and validated results, with no cloud fallback.",
  "keywords": [
    "ai-checker",
    "ai-detector",
    "ai-content-checker",
    "api-client",
    "loopback",
    "typescript",
    "ai-content-detector",
    "content-review"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --main-fields=browser,module,main --target=es2022 --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@opacedev/ai-content-checker-contracts": "file:../contracts",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
