{
  "name": "@opacedev/astro-ai-content-checker",
  "version": "0.3.1",
  "description": "Free AI content checker and on-device AI detector for Astro Dev Toolbar: section evidence, passage highlights and reports, plus model-free build checks.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Opace Digital Agency",
    "url": "https://opace.agency/"
  },
  "homepage": "https://opace.agency/tools/ai/content-verification-integrity/astro-integration/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpaceDigitalAgency/opace-ai-content-checker-detector.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/OpaceDigitalAgency/opace-ai-content-checker-detector/issues"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "withastro",
    "ai-checker",
    "ai-detector",
    "ai-content-checker",
    "devtools",
    "dev-toolbar",
    "privacy",
    "ai-content-detector",
    "ai-text-checker",
    "on-device",
    "content-review"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "SBOM.cdx.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "audit:private": "npm audit --audit-level=high"
  },
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "dependencies": {
    "@opacedev/ai-content-checker-browser": "0.3.1",
    "@opacedev/ai-content-checker-contracts": "0.3.1",
    "@opacedev/ai-content-checker-core": "0.3.1",
    "entities": "4.5.0"
  },
  "devDependencies": {
    "@opace/content-integrity-cycle5-browser": "file:../cycle5-browser",
    "@types/node": "24.3.0",
    "astro": "7.2.7",
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bundleDependencies": [
    "@opacedev/ai-content-checker-browser",
    "@opacedev/ai-content-checker-contracts",
    "@opacedev/ai-content-checker-core",
    "entities"
  ]
}
