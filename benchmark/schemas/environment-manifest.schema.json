{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://opace.example/schemas/environment-manifest-1.0.json","title":"BENCH-10 environment manifest","type":"object","additionalProperties":false,"required":["schema_version","environment_id","os","runtime","cpu","gpu","ram_bytes","dependency_lock_hash","code_evidence_hash","locale","timezone","permitted_secret_identifiers"],
  "properties":{"schema_version":{"const":"1.0"},"environment_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{2,79}$"},"os":{"type":"string","minLength":2},"runtime":{"type":"string","minLength":2},"cpu":{"type":"string","minLength":2},"gpu":{"type":["string","null"]},"ram_bytes":{"type":"integer","minimum":1},"dependency_lock_hash":{"pattern":"^sha256:[a-f0-9]{64}$"},"code_evidence_hash":{"pattern":"^sha256:[a-f0-9]{64}$"},"locale":{"type":"string","minLength":2},"timezone":{"type":"string","minLength":1},"permitted_secret_identifiers":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"}}}
}
