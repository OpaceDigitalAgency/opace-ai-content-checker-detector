{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://opace.example/schemas/corpus-manifest-1.0.json","title":"BENCH-10 corpus manifest","type":"object","additionalProperties":false,
  "required":["schema_version","corpus_id","corpus_version","approved_root","mode","documents"],"properties":{"schema_version":{"const":"1.0"},"corpus_id":{"$ref":"#/$defs/id"},"corpus_version":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"approved_root":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"},"mode":{"enum":["tuning","evaluation","all"]},"documents":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/document"}}},
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{2,79}$"},"document":{"type":"object","additionalProperties":false,"required":["document_id","path","byte_hash","content_location_class","licence_or_consent_record_id","licence_state","language","domain","task","length_band","authorship_edit_state","source_metadata","split"],"properties":{"document_id":{"$ref":"#/$defs/id"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},"byte_hash":{"pattern":"^sha256:[a-f0-9]{64}$"},"content_location_class":{"enum":["public","restricted","synthetic"]},"licence_or_consent_record_id":{"$ref":"#/$defs/id"},"licence_state":{"enum":["approved","hold","rejected"]},"language":{"type":"string","pattern":"^[a-z]{2}(?:-[A-Z]{2})?$"},"domain":{"$ref":"#/$defs/id"},"task":{"$ref":"#/$defs/id"},"length_band":{"enum":["short","medium","long"]},"authorship_edit_state":{"enum":["synthetic_reference","synthetic_edited"]},"source_metadata":{"type":"object","additionalProperties":false,"required":["authoring_party","created_at","model"],"properties":{"authoring_party":{"const":"Opace"},"created_at":{"format":"date-time"},"model":{"type":["string","null"],"maxLength":80}}},"split":{"enum":["tuning","evaluation","held_out"]}}}}
}
