{
  "name": "opace/opace-ai-content-checker-detector",
  "description": "Local content-integrity inspection for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "opis/json-schema": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload": {
    "psr-4": {"Opace\\ContentIntegrity\\": "includes/"}
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true},
    "platform": {"php": "7.4.33"},
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist .",
    "test": "phpunit -c phpunit.xml.dist",
    "test:contracts": "php tests/php/contract-vectors.php"
  }
}
