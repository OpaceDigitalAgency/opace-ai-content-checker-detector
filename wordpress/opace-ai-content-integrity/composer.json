{
  "name": "opace/opace-ai-content-integrity",
  "description": "Local content-integrity inspection for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "opace/content-integrity-contracts": "1.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/contracts/php",
      "options": {
        "symlink": false,
        "versions": {"opace/content-integrity-contracts": "1.0.0"}
      }
    }
  ],
  "autoload": {
    "psr-4": {"Opace\\ContentIntegrity\\": "includes/"}
  },
  "config": {
    "allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true},
    "platform": {"php": "7.4.33"},
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist .",
    "test": "phpunit -c phpunit.xml.dist",
    "test:contracts": "php tests/php/contract-vectors.php"
  }
}
