{
  "name": "opace-ai-content-checker-detector-chrome",
  "version": "1.2.0",
  "private": true,
  "description": "Build and test the local-first Opace AI Content Checker & Detector Chrome extension.",
  "keywords": [
    "chrome-extension",
    "ai-detector",
    "ai-content-checker",
    "privacy",
    "manifest-v3"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
