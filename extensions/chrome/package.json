    "test": "npm run typecheck && node --test ../tests/unit/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.14.3",
