    "@opace/content-integrity-contracts": "file:../../dist/g3-revendor-2026-08-30/opace-content-integrity-contracts-0.0.0-private.tgz",
    "@opace/content-integrity-core": "file:../../dist/g3-revendor-2026-08-30/opace-content-integrity-core-0.0.0-private.tgz",
    "@opace/content-integrity-cycle5-browser": "file:../../packages/cycle5-browser"
  },
  "devDependencies": {
    "@types/chrome": "0.1.36",
    "axe-core": "^4.10.3",
    "esbuild": "0.28.2",
