{
  "product": "AI Content Integrity Checker by Opace",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "145",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "clipboardWrite"
  ],
  "optional_host_permissions": [],
  "features": {
    "selection": true,
    "visible_article": true,
    "paste": true,
    "browser_worker": true,
    "hash_only_receipts": true,
    "receipt_history": false,
    "loopback_pairing": false,
    "page_write_back": false,
    "telemetry": false
  }
}
